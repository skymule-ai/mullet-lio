# Start Livox and the LIO development container with `docker compose up`.
COMPOSE_PROFILES=lio

# Base used by the empty LIO development image.
BASE_IMAGE=ghcr.io/skymule-ai/mullet-ros2-base:v0.4.0

# Use the Livox image built locally from mullet_ros_drivers while developing.
# Replace this with an immutable release or SHA tag for integration testing.
LIVOX_IMAGE=ghcr.io/skymule-ai/mullet-ros-livox:local
LIO_IMAGE=ghcr.io/skymule-ai/mullet-ros-lio:local

# Single source of truth for the Livox runtime configuration. Override this
# with a robot deployment configuration path when one is available.
LIVOX_CONFIG_FILE=../mullet_ros_drivers/config/livox/MID360s_config.json

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Command run by the LIO development container. Keep it alive for interactive
# builds until a real package launch command is added.
LIO_COMMAND=exec sleep infinity
