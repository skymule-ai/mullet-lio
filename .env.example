# Immutable release inherited by LIO images at build time.
BASE_IMAGE=ghcr.io/skymule-ai/mullet-base:v0.5.1

# Pin FAST_LIO_REF to a full upstream commit SHA for reproducible builds.
FAST_LIO_REPOSITORY=https://github.com/hku-mars/FAST_LIO.git
FAST_LIO_REF=a4743b095409588842a5b30ddfa27e29d2f99164

# Livox driver (mullet-drivers): run beside FAST-LIO, and the source of the livox_ros_driver2
# messages copied into the FAST-LIO image at build time. Immutable tag (v0.5.0 once released).
LIVOX_IMAGE=ghcr.io/skymule-ai/mullet-drivers-livox:sha-29ab1e8
# Host interface wired to the MID-360 (192.168.1.50/24); livox-ptp runs the PTP master on it.
LIVOX_IFACE=eth1

# Local builds use this tag. CI replaces it with branch, SHA, and release tags.
FAST_LIO_IMAGE=ghcr.io/skymule-ai/mullet-lio-fast-lio:local

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
