# The base and the Livox build source are pinned in images/fast-lio/Dockerfile (ARG BASE_IMAGE,
# ARG LIVOX_IMAGE): one line to bump, read as is by Compose and CI.

# Pin FAST_LIO_REF to a full upstream commit SHA for reproducible builds.
FAST_LIO_REPOSITORY=https://github.com/hku-mars/FAST_LIO.git
FAST_LIO_REF=a4743b095409588842a5b30ddfa27e29d2f99164

# Livox driver (mullet-drivers) run beside FAST-LIO. Keep it the Dockerfile's LIVOX_IMAGE, the image
# the livox_ros_driver2 messages are copied from, so both sides have the same message build.
LIVOX_IMAGE=ghcr.io/skymule-ai/mullet-drivers-livox:sha-8f9159f
# Host interface wired to the MID-360 (192.168.1.50/24); livox-ptp runs the PTP master on it.
LIVOX_IFACE=eth1

# Local builds use this tag. CI replaces it with branch, SHA, and release tags.
FAST_LIO_IMAGE=ghcr.io/skymule-ai/mullet-lio-fast-lio:local

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
